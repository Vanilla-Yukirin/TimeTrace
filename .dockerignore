# Do not ship caches, artifacts, local state, or development-only files.

# Python
__pycache__
*.py[cod]
*.egg-info
.venv
venv

# Test / lint scratch
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Frontend dependencies and local build output. Source is part of the image
# build so the SPA and server always share one immutable SHA.
frontend/node_modules
frontend-dist
node_modules

# Local data, credentials, and tokens are bind mounts, never image content.
data
tokens
TimeTraceData
TimeTraceData-archive-*
.env
.env.*
*.log

# Repository metadata and development-only material
.git
.github
.gitignore
devlogs
docs
infra
tests
CLAUDE.md
LICENSE
