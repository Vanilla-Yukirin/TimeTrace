TIMETRACE_VLM_BASE_URL=https://api.openai.com/v1
TIMETRACE_VLM_API_KEY=
TIMETRACE_VLM_MODEL=gpt-4o-mini

# Set to "true" only when the endpoint defaults thinking ON and accepts the
# OpenAI-compatible extension `extra_body={"enable_thinking": False}`
# (DashScope qwen / SiliconFlow Qwen3+ etc.). Vanilla api.openai.com
# rejects unknown body fields with HTTP 400, so default is empty/false.
TIMETRACE_VLM_DISABLE_THINKING=

# Server default view time zone (IANA name, e.g. Asia/Shanghai). Storage is
# always UTC epoch ms; requests may override per call with an `X-Timezone`
# header or `?tz=` (the web UI sends the browser's zone). Also the zone the
# summary pyramid cuts its 6h/day/week windows in. Empty = process local zone.
TIMETRACE_TZ=
